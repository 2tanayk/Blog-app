# PostgreSQL
POSTGRES_DB=BlogDB                  # Database name for the blog application
POSTGRES_USER=postgres              # PostgreSQL superuser / application user
POSTGRES_PASSWORD=change_me         # Password for the PostgreSQL user

# Spring Boot
DB_PASSWORD=change_me               # Same as POSTGRES_PASSWORD — passed to Spring's datasource config
JWT_SECRET=change_me                # Base64-encoded HMAC-SHA key for signing JWTs

# OAuth2 (Google) — optional, leave blank if not testing social login
GOOGLE_CLIENT_ID=                   # OAuth 2.0 client ID from Google Cloud Console
GOOGLE_CLIENT_SECRET=               # OAuth 2.0 client secret from Google Cloud Console

# Frontend
APP_FRONTEND_URL=http://localhost:3000  # URL of the frontend app (for OAuth redirects and CORS)